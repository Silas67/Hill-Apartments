# Copy this file to .env.local for local development, and set the same three
# variables in your hosting provider (Vercel: Project > Settings > Environment
# Variables). Without them the contact form and newsletter return an error
# instead of silently swallowing enquiries.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives website enquiries
CONTACT_TO=info@ogwinners.com

# Verified sender on a domain you control — Resend must have this domain
# verified before it will deliver. A free @gmail.com address will NOT work.
CONTACT_FROM=website@ogwinners.com
